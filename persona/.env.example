NODE_ENV=development
PORT=4400
DATABASE_URL="postgresql://persona:persona@localhost:55432/persona?schema=public"
AUTH_SECRET="change-me"
OIDC_ISSUER="http://localhost:4400/oidc"
# Send OIDC login/consent pages to the web app (leave unset to use the built-in HTML)
WEB_URL="http://localhost:4420"
# How the emailed codes go out. `resend` really sends them; `console` writes
# them to the log instead, which is how the app is demonstrated without a
# provider that will accept the address — Resend refuses `example.com`, and the
# seeded demo user lives there. `console` is refused in production unless
# DEMO_LOGIN is on, because then nobody is waiting on an email anyway.
MAIL_TRANSPORT="console"
# Required unless MAIL_TRANSPORT=console. Get one at https://resend.com.
# RESEND_API_KEY="re_change_me"
# Must be a domain verified in Resend. The default sends only to the address
# that owns the Resend account, which is enough to try it out.
EMAIL_FROM="Persona <onboarding@resend.dev>"
# Where rate-limit counters live. `npm run db:up` starts one alongside Postgres.
# Leave it unset and the limits fall back to an in-process map, which forgets
# everything on restart — fine on a laptop, refused in production by config.ts.
REDIS_URL="redis://localhost:56379"
# Turns the limiter off entirely. The load test uses it to measure the same
# endpoint with and without.
# RATE_LIMIT_ENABLED=false
# How many proxies sit in front of the API, for req.ip. A hosted copy answers
# through the web app's rewrites, so it needs this set or every caller looks
# like the proxy. Verify the header actually survives the chain before raising
# it: only the public-read limit uses it, and that one fails open.
# TRUST_PROXY_HOPS=1

# --- Only a hosted copy needs the rest ---

# A signing key to start from, as the JSON of a JWK set. Read once: the first
# boot adopts it into the signing_key table, keeping its kid exactly as it is so
# tokens already in flight still verify, and never looks at it again. After that
# the keys live in the database, encrypted at rest, and rotate on their own
# schedule — `npm run keys` shows what is published, `npm run keys:rotate`
# starts a rollover. With neither this nor a stored key, the app mints one.
# OIDC_JWKS='{"keys":[...]}'

# The rotation schedule itself is not an environment variable: it lives in
# src/constants/keys.ts, where the arithmetic that sets the overlap window can
# be read alongside it.


# Offers one-click sign-in as the accounts below, on the sign-in screens, and
# says on the page that it is a demo. The codes are never emailed, so this is
# the only way into a public copy — and it is a way past the password, which is
# why it is off unless asked for and limited to accounts nobody owns.
# DEMO_LOGIN=true
# DEMO_LOGIN_EMAILS="camila@example.com,dev@example.com"

# Where the demo relying parties answer, and the secrets they authenticate
# with. The seed writes these into the database as each app's registered
# redirect URI, so a hosted copy must set them or the OAuth flow will bounce
# every request back to localhost.
# CLINIC_URL="https://clinic.example.com"
# FORUM_URL="https://forum.example.com"
# STORE_URL="https://store.example.com"
# PROBE_URL="https://probe.example.com"
# CLINIC_CLIENT_SECRET="..."
# FORUM_CLIENT_SECRET="..."
# STORE_CLIENT_SECRET="..."
# PROBE_CLIENT_SECRET="..."
