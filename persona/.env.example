NODE_ENV=development
PORT=4400
DATABASE_URL="postgresql://persona:persona@localhost:55432/persona?schema=public"
AUTH_SECRET="change-me"
OIDC_ISSUER="http://localhost:4400/oidc"
# Send OIDC login/consent pages to the web app (leave unset to use the built-in HTML)
WEB_URL="http://localhost:4420"
# How the emailed codes go out. `resend` really sends them; `console` writes
# them to the log instead, which is how the app is demonstrated without a
# provider that will accept the address — Resend refuses `example.com`, and the
# seeded demo user lives there. `console` is refused in production.
MAIL_TRANSPORT="console"
# Required unless MAIL_TRANSPORT=console. Get one at https://resend.com.
# RESEND_API_KEY="re_change_me"
# Must be a domain verified in Resend. The default sends only to the address
# that owns the Resend account, which is enough to try it out.
EMAIL_FROM="Persona <onboarding@resend.dev>"
