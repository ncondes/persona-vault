{
  "name": "persona",
  "version": "0.1.0",
  "description": "Persona — a context-aware identity and profile management API",
  "author": "Nicolas Conde Salazar <ncondesalazar@gmail.com>",
  "license": "MIT",
  "private": true,
  "main": "dist/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "jest",
    "test:int": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.int.config.js",
    "test:cov": "NODE_OPTIONS=--experimental-vm-modules jest --config jest.all.config.js --coverage",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "acceptance": "tsx scripts/acceptance-table.ts",
    "perf": "tsx scripts/perf-userinfo.ts",
    "preview:email": "tsx scripts/preview-otp-email.ts",
    "db:up": "docker compose -f ../docker-compose.yml up -d postgres --wait",
    "db:down": "docker compose -f ../docker-compose.yml down",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "oidc-provider": "^9.8.5",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "resend": "^6.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.0.0",
    "@types/oidc-provider": "^9.5.0",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "autocannon": "^8.0.0",
    "jest": "^30.4.2",
    "prisma": "^7.8.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
