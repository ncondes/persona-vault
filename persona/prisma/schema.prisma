generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NameVariantKind {
  legal
  preferred
  professional
  public
}

enum ProfileFieldKey {
  email
  phone
  address
  dob
}

// A person who owns a profile in Persona.
model User {
  id           String         @id @default(uuid())
  email        String         @unique
  passwordHash String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  nameVariants NameVariant[]
  profileFields ProfileField[]
  consents     Consent[]
  auditEntries AuditEntry[]
}

// A version of the user's name for a given context (legal, preferred, ...).
model NameVariant {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NameVariantKind
  value     String
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, kind])
}

// A single profile field (email, phone, ...) the user can share.
model ProfileField {
  id        String          @id @default(uuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       ProfileFieldKey
  value     String
  sensitive Boolean         @default(false)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([userId, key])
}

// A relying party (an app/institution) that can request user data. Its primary
// key is the OAuth client_id used during "Connect with Persona".
model Client {
  id            String       @id
  name          String
  purpose       String
  allowedScopes String[]
  redirectUris  String[]
  secretHash    String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  consents      Consent[]
  auditEntries  AuditEntry[]
}

// A user's standing consent for a client to receive a set of scopes.
model Consent {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes    String[]
  grantedAt DateTime @default(now())

  @@unique([userId, clientId])
}

// A record of one release of data to a client.
model AuditEntry {
  id             String   @id @default(uuid())
  at             DateTime @default(now())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  context        String
  scopesReleased String[]
  fieldsReleased String[]
}
