generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Every kind of data the vault can hold. `allergy` holds one item per allergy.
enum VaultKind {
  name
  username
  avatar
  birth_date
  document
  email
  phone
  address
  blood_type
  eps
  allergy

  @@map("vault_kind")
}

// Which context a name value belongs to (legal, preferred, ...). Only set on
// items of kind `name`.
enum NameContext {
  legal
  preferred
  professional
  public

  @@map("name_context")
}

enum AuditType {
  grant
  release
  revoke

  @@map("audit_type")
}

enum ClientStatus {
  active
  disabled

  @@map("client_status")
}

// Which flow an emailed code is standing in front of.
enum OtpPurpose {
  signup
  login

  @@map("otp_purpose")
}

// A person who owns a vault in Persona.
model User {
  id               String       @id @default(uuid())
  email            String       @unique
  passwordHash     String       @map("password_hash")
  confirmSensitive Boolean      @default(true) @map("confirm_sensitive")
  notifyAccess     Boolean      @default(false) @map("notify_access")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  vaultItems       VaultItem[]
  consents         Consent[]
  auditEntries     AuditEntry[]
  apps             Client[]
  otpChallenges    OtpChallenge[]

  @@map("user")
}

// A sign-up or sign-in waiting on the code that was emailed to `email`.
//
// A sign-up lives here in full — name, address and password hash — until the
// code comes back, so an address nobody reached never reaches the `user` table.
// A sign-in only points at the account it will open. The two column groups are
// mutually exclusive; `CreateChallengeInput` in the repository interface is a
// discriminated union so the wrong combination cannot be written.
model OtpChallenge {
  id           String     @id @default(uuid())
  purpose      OtpPurpose
  email        String
  userId       String?    @map("user_id")
  user         User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String?    @map("first_name")
  lastName     String?    @map("last_name")
  passwordHash String?    @map("password_hash")
  codeHash     String     @map("code_hash")
  expiresAt    DateTime   @map("expires_at")
  attempts     Int        @default(0)
  sends        Int        @default(1)
  lastSentAt   DateTime   @map("last_sent_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([email, purpose])
  @@index([expiresAt])
  @@map("otp_challenge")
}

// One piece of data in the user's vault. A kind can hold several values, each
// with a user label ("Personal", "Work") and at most one default per kind.
model VaultItem {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        VaultKind
  label       String?
  value       String
  detail      Json? // structured parts for name, phone, address and document
  isDefault   Boolean      @default(false) @map("is_default")
  nameContext NameContext? @map("name_context")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  @@index([userId, kind])
  @@map("vault_item")
}

// A relying party registered through the developer console. Its primary key is
// the OAuth client_id used during "Connect with Persona". The OIDC provider
// reads clients from this table through the adapter in src/oidc/adapter.ts.
model Client {
  id              String       @id
  ownerId         String       @map("owner_id")
  owner           User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  purpose         String
  accent          String       @default("teal")
  allowedScopes   String[]     @map("allowed_scopes")
  requiredScopes  String[]     @map("required_scopes")
  redirectUris    String[]     @map("redirect_uris")
  // oidc-provider compares client secrets in plaintext, so they are encrypted
  // at rest rather than hashed. See src/infrastructure/crypto/secret-box.ts.
  secretEncrypted String       @map("secret_encrypted")
  secretLastFour  String       @map("secret_last_four")
  status          ClientStatus @default(active)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  consents        Consent[]
  auditEntries    AuditEntry[]

  @@index([ownerId])
  @@map("client")
}

// A user's standing consent for a client: which scopes were granted and which
// vault items back each one (with a snapshot of the values at approval).
model Consent {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String   @map("client_id")
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  scopes     String[]
  selections Json
  grantId    String?  @map("grant_id")
  grantedAt  DateTime @default(now()) @map("granted_at")

  @@unique([userId, clientId])
  @@map("consent")
}

// A record of one consent grant, data release, or revocation.
model AuditEntry {
  id             String    @id @default(uuid())
  at             DateTime  @default(now())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId       String    @map("client_id")
  client         Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type           AuditType @default(release)
  context        String
  scopesReleased String[]  @map("scopes_released")
  fieldsReleased String[]  @map("fields_released")

  @@index([clientId, at])
  @@map("audit_entry")
}

// oidc-provider's storage: one row per artifact (session, interaction, grant,
// authorization code, token), keyed on model + id, plus the secondary lookups
// its adapter contract requires. Clients are the exception — they live in
// `client` and are read from there by the adapter.
model OidcPayload {
  model     String
  id        String
  payload   Json
  grantId   String?   @map("grant_id")
  userCode  String?   @map("user_code")
  uid       String?
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@id([model, id])
  @@unique([uid])
  @@unique([userCode])
  @@index([grantId])
  @@index([expiresAt])
  @@map("oidc_payload")
}
