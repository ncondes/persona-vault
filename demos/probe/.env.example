# Where the browser is sent to sign in. Must be reachable from the user's browser.
PERSONA_PUBLIC_URL=http://localhost:4400
# Where this server calls the token, userinfo and API endpoints. Inside Docker
# Compose that is the service name, not localhost.
PERSONA_INTERNAL_URL=http://localhost:4400
# Persona's user interface, linked to from the console for the revocation step.
PERSONA_WEB_URL=http://localhost:4420
# From the Persona developer console. Registered as a social app asking for a
# name and a handle — which is exactly the point.
CLIENT_ID=probe
CLIENT_SECRET=probe-dev-secret
# This app's own origin, used to build the redirect URI.
APP_URL=http://localhost:4414
