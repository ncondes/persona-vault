# Where the browser is sent to sign in. Must be reachable from the user's browser.
PERSONA_PUBLIC_URL=http://localhost:4400
# Where this server calls the token and userinfo endpoints. Inside Docker
# Compose that is the service name, not localhost.
PERSONA_INTERNAL_URL=http://localhost:4400
# Persona's user interface, linked to from the home screen.
PERSONA_WEB_URL=http://localhost:4420
# From the Persona developer console.
CLIENT_ID=store
CLIENT_SECRET=store-dev-secret
# This app's own origin, used to build the redirect URI.
APP_URL=http://localhost:4413
# The domain-verification token from the Persona developer console, served at
# /.well-known/persona-challenge.txt. Unset means unverified, and the consent
# screen says so.
# PERSONA_VERIFICATION_TOKEN=
