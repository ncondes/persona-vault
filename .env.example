# Shared by docker compose and persona/.env. Client secrets are encrypted
# with a key derived from this, so the two must agree — change it and you
# must re-run the seed.
AUTH_SECRET="change-me"

# Sign-up and sign-in both send a 6-digit code by email, so compose will refuse
# to start the API without a key. Get one at https://resend.com.
RESEND_API_KEY="re_change_me"

# Optional. Must be a domain verified in Resend; the default only delivers to
# the address that owns the Resend account, which is enough to try it out.
EMAIL_FROM="Persona <onboarding@resend.dev>"
